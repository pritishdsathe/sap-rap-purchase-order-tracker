@EndUserText.label : 'Draft table for entity ZI_PO_TRACKER'
@AbapCatalog.enhancement.category : #EXTENSIBLE_ANY
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table zpo_d_tracker {

  key mandt                : mandt not null;
  key purchaseorder        : ebeln not null;
  companycode              : bukrs;
  purchasedocumentcategory : bstyp;
  @Semantics.amount.currencyCode : 'zpo_d_tracker.currency'
  amount                   : netwr;
  currency                 : waers;
  @Semantics.quantity.unitOfMeasure : 'zpo_d_tracker.uom'
  quantity                 : menge_d;
  uom                      : meins;
  status                   : zde_mat_status;
  creationdate             : aedat;
  createdby                : abp_creation_user;
  createdat                : abp_creation_tstmpl;
  "%admin"                 : include sych_bdl_draft_admin_inc;

}
